# Copy this file to `.env.local` and replace the placeholder values.
# Vite loads `.env.local` automatically on startup.
# Restart the dev server after editing env files.

# Browser-safe client config used by `src/integrations/supabase/client.ts`
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional convenience value for local tooling and diagnostics
VITE_SUPABASE_PROJECT_ID=your-project-ref

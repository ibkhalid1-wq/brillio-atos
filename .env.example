# Supabase project URL (from Supabase dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose client-side)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Optional: used by Supabase CLI tooling only
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Edge Functions: Anthropic model access
ANTHROPIC_API_KEY=your-anthropic-api-key

# Edge Functions: service-role access for server-side jobs and scheduling
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

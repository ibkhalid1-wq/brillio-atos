{
  "name": "brillio-atos",
  "private": true,
  "version": "1.0.0",
  "description": "Brillio ATOS™ — Agentic Transformation Operating System. AI-Native Transformation Platform.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:edge": "deno check supabase/functions/flow-portal/index.ts supabase/functions/flow-transcribe/index.ts",
    "validate": "npm run typecheck && npm run check:edge-syntax && npm run check:edge-types && npm run lint && npm run build && npm run test",
    "test": "vitest run",
    "claims:regen": "vite-node scripts/claims/regen.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check:edge-syntax": "esbuild supabase/functions/run-agent/index.ts supabase/functions/_shared/*.ts --outdir=/tmp/edge-syntax-check --log-level=error",
    "check:edge-types": "node scripts/edge-types/check.mjs",
    "gen:db-types": "supabase gen types typescript --project-id vudqrrqpipnkxzxslbim > supabase/functions/_shared/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "@xyflow/react": "^12.11.0",
    "@zip.js/zip.js": "^2.8.26",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.10",
    "elkjs": "^0.11.1",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "officeparser": "^7.2.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^0.34.6",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "supabase": "^2.105.0",
    "tsx": "^4.20.1",
    "typescript": "^5.4.5",
    "vite": "^4.4.5",
    "vitest": "^0.34.6"
  }
}
